    </div>
    <div class="titleblock">
      <div class="c k">Kohde</div><div class="c v" style="grid-column:2/-1;border-right:0">${esc(m.kohde || "—")}</div>
      <div class="c k">Osoite</div><div class="c v" style="grid-column:2/-1;border-right:0">${esc(m.osoite || "—")}</div>
      ${cell("Keskus", m.tunnus)}${cell("Piir.nro", m.pno, "last")}
      ${cell("Suunn.", m.tekija)}${cell("Päiväys", m.pvm, "last")}
      <div class="c k bot">Sisältö</div><div class="c v bot">Keskuskaavio</div>
      <div class="c k bot">Mittak.</div><div class="c v bot last">${scaleTxt}</div>
    </div>`;
}
function renderDrawing() {
  const { w, h } = pageDims(), sheet = $("#sheetDrawing");
  sheet.style.width = w + "mm"; sheet.style.height = h + "mm";
  sheet.innerHTML = `<div class="frame">
      <div class="drawarea"><div class="panelwrap"><div id="panel"><div class="cabinet">
        ${state.rows.map(rowBlockHTML).join("") || '<div style="padding:20mm;font-size:4mm;color:#888">Lisää rivi vasemmalta.</div>'}
      </div></div></div></div>
      ${titleBlockHTML("1:1")}
    </div>`;
  fitPanel();
}
function fitPanel() {
  const panel = $("#panel"); if (!panel) return;
  const wrap = panel.parentElement, area = wrap.parentElement;
  panel.style.transform = "none"; wrap.style.width = "auto"; wrap.style.height = "auto";
  const nw = panel.offsetWidth / PXMM, nh = panel.offsetHeight / PXMM;
  const aw = area.clientWidth / PXMM, ah = area.clientHeight / PXMM;
  let s = 1;
  if (state.scaleMode === "fit") s = Math.min(aw / nw, ah / nh, 1);
  else s = parseFloat(state.scaleMode) || 1;
  panel.style.transform = "scale(" + s + ")";
  wrap.style.width = (nw * s) + "mm"; wrap.style.height = (nh * s) + "mm";
  const tb = $("#sheetDrawing .titleblock .c.v.bot.last");
  if (tb) tb.textContent = s >= 0.999 ? "1:1" : "1:" + (1 / s).toFixed(2).replace(/\.?0+$/, "").replace(".", ",");
}
function renderLabels() {
  const { w, h } = pageDims(), sheet = $("#sheetLabels"), o = state.opts;
  sheet.style.width = w + "mm"; sheet.style.minHeight = h + "mm";
  const blocks = [];
  state.rows.forEach((r, i) => {
