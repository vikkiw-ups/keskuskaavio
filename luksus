      blocks.push(`<div class="stripblock">
        <div class="stripcap"><b>${i + 1}. ${esc(r.name)}</b>
          <span>${Math.max(r.modules, used(r))} mod · ${(Math.max(r.modules, used(r)) * MOD()).toFixed(1).replace(".", ",")} mm · korkeus ${String(o.stripH).replace(".", ",")} mm</span>
          ${(o.copies || 1) > 1 ? `<span>kopio ${c + 1}/${o.copies}</span>` : ""}</div>
        ${stripHTML(r, false)}</div>`);
    }
  });
  sheet.innerHTML = `<h1 class="sheetTitle">Merkintäliuskat<span>${esc(state.meta.tunnus || "")} ${esc(state.meta.kohde || "")}</span></h1>
    <p class="printnote">Tulosta mittakaavassa 100 % (poista “sovita sivulle”). Leikkaa liuskat katkoviivoja pitkin ja aseta kojeiden merkintäuraan.</p>
    ${blocks.join("") || '<p class="printnote">Ei rivejä.</p>'}`;
}
function renderList() {
  const { w, h } = pageDims(), sheet = $("#sheetList");
  sheet.style.width = w + "mm"; sheet.style.minHeight = h + "mm";
  let rows = "";
  state.rows.forEach((r, i) => {
