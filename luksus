  if (e.key === "ArrowLeft") { e.preventDefault(); moveDev(sel.dev, -1); }
  if (e.key === "ArrowRight") { e.preventDefault(); moveDev(sel.dev, 1); }
});

/* ---------- raahaus ---------- */
let dragId = null, marker = null;
$("#sheetDrawing").addEventListener("dragstart", e => {
  const d = e.target.closest("[data-dev]"); if (!d) return;
  dragId = d.dataset.dev; d.classList.add("dragging");
  e.dataTransfer.setData("text/plain", "move:" + dragId);
  e.dataTransfer.effectAllowed = "move";
});
$("#sheetDrawing").addEventListener("dragend", () => {
  dragId = null; if (marker) { marker.remove(); marker = null; }
  $$("#sheetDrawing .dev").forEach(el => el.classList.remove("dragging"));
});
function insertIndex(rail, clientX) {
  const row = rowById(rail.dataset.rail);
  const r = rail.getBoundingClientRect();
  const total = Math.max(row.modules, used(row));
  const pos = ((clientX - r.left) / (r.width || 1)) * total; // moduuleina
  let acc = 0, i = 0;
  for (; i < row.devices.length; i++) {
    const w = row.devices[i].w;
    if (pos < acc + w / 2) break;
    acc += w;
  }
  return { row, index: i, mm: acc * MOD() };
}
$("#sheetDrawing").addEventListener("dragover", e => {
  const rail = e.target.closest("[data-rail]"); if (!rail) return;
  e.preventDefault(); e.dataTransfer.dropEffect = dragId ? "move" : "copy";
  const { mm } = insertIndex(rail, e.clientX);
  if (!marker) { marker = document.createElement("div"); marker.className = "dropmark"; }
  marker.style.left = mm.toFixed(2) + "mm";
  if (marker.parentElement !== rail) rail.appendChild(marker);
});
$("#sheetDrawing").addEventListener("drop", e => {
  const rail = e.target.closest("[data-rail]"); if (!rail) return;
  e.preventDefault();
  const data = e.dataTransfer.getData("text/plain") || "";
  const { row, index } = insertIndex(rail, e.clientX);
  if (marker) { marker.remove(); marker = null; }
  if (data.startsWith("new:")) {
    const key = data.slice(4);
    if (!CAT[key].kinds.includes(row.kind)) { alert("Tämä koje ei sovi valitulle rivityypille."); return; }
    addDevice(key, row.id, index);
  } else if (dragId) {
    const f = findDev(dragId); if (!f) return;
    const same = f.row === row;
    const from = f.row.devices.indexOf(f.dev);
    f.row.devices.splice(from, 1);
    let idx = index; if (same && from < index) idx--;
    row.devices.splice(Math.max(0, idx), 0, f.dev);
    sel.row = row.id; sel.dev = f.dev.id;
    dragId = null; renderAll();
  }
});

