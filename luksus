      <th style="width:18mm">Suojaus</th><th style="width:16mm">Vikavirta</th><th style="width:30mm">Kaapeli</th><th>Merkintä</th>
    </tr></thead><tbody>${rows}</tbody></table>`;
}

/* ============================================================
   ZOOM / NÄKYMÄ
============================================================ */
function applyZoom() {
  const sheet = $(".sheet.active"); if (!sheet) return;
  const w = sheet.offsetWidth, h = sheet.offsetHeight;
  if (zoomAuto) {
    const avail = $("#stage").clientWidth - 60;
    zoom = Math.max(0.12, Math.min(1.6, avail / w));
  }
  $("#scaler").style.transform = "scale(" + zoom + ")";
  $("#holder").style.width = (w * zoom) + "px";
  $("#holder").style.height = (h * zoom) + "px";
  $("#zVal").textContent = Math.round(zoom * 100) + " %";
}
function setView(v) {
  view = v;
  $$("#tabs button").forEach(b => b.classList.toggle("active", b.dataset.view === v));
  $$(".sheet").forEach(s => s.classList.toggle("active", s.dataset.view === v));
  $("#stageHint").textContent = v === "drawing"
    ? "Napsauta kojetta muokataksesi. Raahaa järjestääksesi uudelleen."
    : v === "labels" ? "Liuskat ovat todellisessa koossa (1:1) tulostettaessa."
    : "Luettelo päivittyy automaattisesti piirustuksen mukaan.";
  updatePageStyle();
  applyZoom();
}
function updatePageStyle() {
  let st = $("#pagestyle");
  if (!st) { st = document.createElement("style"); st.id = "pagestyle"; document.head.appendChild(st); }
  const size = state.paper + " " + (state.orient === "landscape" ? "landscape" : "portrait");
  const margin = view === "drawing" ? "0" : "10mm";
  st.textContent = "@page{size:" + size + ";margin:" + margin + "}";
}

