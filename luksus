/* ============================================================
   TOIMINNOT
============================================================ */
function addDevice(key, rowId, index) {
  const row = rowById(rowId || sel.row) || state.rows[0];
  if (!row) return;
  const d = newDev(key);
  if (typeof index === "number") row.devices.splice(index, 0, d); else row.devices.push(d);
  sel.row = row.id; sel.dev = d.id;
  renderAll();
}
function deleteDev(id) {
  const f = findDev(id); if (!f) return;
  f.row.devices = f.row.devices.filter(x => x.id !== id);
  if (sel.dev === id) sel.dev = null;
  renderAll();
}
function moveDev(id, dir) {
  const f = findDev(id); if (!f) return;
  const arr = f.row.devices, i = arr.indexOf(f.dev), j = i + dir;
  if (j < 0 || j >= arr.length) return;
  arr.splice(i, 1); arr.splice(j, 0, f.dev);
  renderAll();
}
function autoNumber() {
  let n = 1;
  state.rows.forEach(r => r.devices.forEach(d => { if (CAT[d.key].prot) d.group = String(n++); }));
  renderAll();
}

