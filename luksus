      state.opts = Object.assign(template("tyhja").opts, o.opts || {});
      sel = { row: state.rows[0] ? state.rows[0].id : null, dev: null };
      syncForms(); updatePageStyle(); renderAll();
    } catch (err) { alert("Tiedostoa ei voitu lukea. Valitse tällä työkalulla tallennettu .json-tiedosto."); }
  };
  fr.readAsText(file);
  e.target.value = "";
});

function syncForms() {
  $$("[data-meta]").forEach(el => el.value = state.meta[el.dataset.meta] || "");
  $$("[data-opt]").forEach(el => {
    const v = state.opts[el.dataset.opt];
    if (el.type === "checkbox") el.checked = !!v; else el.value = v;
  });
  $("#paper").value = state.paper; $("#orient").value = state.orient; $("#scalemode").value = state.scaleMode;
}

let rt;
window.addEventListener("resize", () => { clearTimeout(rt); rt = setTimeout(() => { fitPanel(); applyZoom(); }, 120); });

syncForms(); updatePageStyle(); renderAll();
</script>
</body>
</html>
