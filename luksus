<!DOCTYPE html>
<html lang="fi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Keskussuunnittelija — sähkökeskuksen piirustus ja merkintäliuskat</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ============ TOKENS ============ */
:root{
  --shell:#15171c; --panel:#1c1f26; --panel2:#232732; --line:#30353f; --line2:#3d434f;
  --ink:#e9ecf1; --muted:#98a0ae; --signal:#f2b134; --live:#c8412c; --cool:#4a90d9;
  --ok:#4caf7d;
  --paper:#fff; --pink:#1a1d22; --pink2:#5a6270;
  --ui: "Barlow Condensed", "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --body: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --r:2px;
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--shell);color:var(--ink);font-family:var(--body);font-size:13px;overflow:hidden}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--signal);outline-offset:1px}

/* ============ SHELL ============ */
#app{display:flex;flex-direction:column;height:100%}
#topbar{display:flex;align-items:center;gap:14px;padding:0 12px;height:50px;background:var(--panel);border-bottom:1px solid var(--line);flex:0 0 auto;flex-wrap:wrap}
.brand{font-family:var(--ui);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:16px;display:flex;align-items:center;gap:8px;white-space:nowrap}
.brand b{color:var(--signal);font-weight:700}
.tabs{display:flex;border:1px solid var(--line2);border-radius:var(--r);overflow:hidden}
.tabs button{background:transparent;border:0;padding:7px 14px;color:var(--muted);font-family:var(--ui);font-size:14px;letter-spacing:.04em;text-transform:uppercase;border-right:1px solid var(--line2)}
.tabs button:last-child{border-right:0}
.tabs button.active{background:var(--signal);color:#161616;font-weight:600}
.spacer{flex:1}
.tool{display:flex;align-items:center;gap:6px}
label.tl{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-family:var(--ui)}
select,input[type=text],input[type=number],textarea{background:var(--panel2);border:1px solid var(--line2);border-radius:var(--r);padding:5px 7px;color:var(--ink)}
select{padding-right:4px}
input[type=text]:hover,select:hover{border-color:#525a68}
.btn{background:var(--panel2);border:1px solid var(--line2);border-radius:var(--r);padding:6px 11px;color:var(--ink);font-family:var(--ui);letter-spacing:.04em;text-transform:uppercase;font-size:13px}
.btn:hover{background:#2b303b}
.btn.primary{background:var(--signal);border-color:var(--signal);color:#161616;font-weight:600}
.btn.primary:hover{background:#ffc352}
.btn.danger:hover{background:#3a2020;border-color:#7d3a30;color:#ffb3a7}
.btn.sm{padding:3px 7px;font-size:12px}

#main{flex:1;display:flex;min-height:0}
aside{background:var(--panel);width:268px;flex:0 0 268px;overflow-y:auto;border-right:1px solid var(--line)}
#right{border-right:0;border-left:1px solid var(--line);width:280px;flex-basis:280px}
aside::-webkit-scrollbar,#stage::-webkit-scrollbar{width:10px;height:10px}
aside::-webkit-scrollbar-thumb,#stage::-webkit-scrollbar-thumb{background:#333945;border-radius:5px}

details.sec{border-bottom:1px solid var(--line)}
details.sec>summary{list-style:none;cursor:pointer;padding:11px 12px;font-family:var(--ui);text-transform:uppercase;letter-spacing:.09em;font-size:12.5px;color:var(--muted);display:flex;align-items:center;gap:7px;user-select:none}
details.sec>summary::-webkit-details-marker{display:none}
details.sec>summary::before{content:"+";color:var(--signal);font-family:var(--mono);font-size:13px}
details.sec[open]>summary::before{content:"–"}
details.sec[open]>summary{color:var(--ink)}
.secbody{padding:0 12px 14px}

.field{margin-bottom:8px}
.field label{display:block;font-size:10.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);margin-bottom:3px;font-family:var(--ui)}
.field input,.field select,.field textarea{width:100%}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.hint{font-size:11.5px;color:var(--muted);line-height:1.5}
.hint code{font-family:var(--mono);color:var(--signal);font-size:11px}

/* row list */
.rowitem{border:1px solid var(--line2);border-radius:var(--r);padding:8px;margin-bottom:8px;background:#1a1d24}
.rowitem.active{border-color:var(--signal);box-shadow:inset 3px 0 0 var(--signal)}
.rowitem .rhead{display:flex;align-items:center;gap:6px;margin-bottom:6px}
.rowitem .rno{font-family:var(--mono);font-size:11px;color:var(--signal);min-width:18px}
.rowitem input.rname{flex:1;min-width:0;background:transparent;border:0;border-bottom:1px dashed var(--line2);padding:2px 0;font-family:var(--ui);font-size:14px}
.rowitem .rmeta{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--muted)}
.rowitem .rmeta input{width:52px;padding:2px 4px;font-family:var(--mono);font-size:11px}
.rowitem .rmeta select{padding:2px 4px;font-size:11px}
.usage{font-family:var(--mono);font-size:11px;margin-left:auto;color:var(--muted)}
.usage.over{color:#ff8a72}
.rowbtns{display:flex;gap:4px;margin-top:6px}
.iconbtn{background:#262b34;border:1px solid var(--line2);border-radius:var(--r);width:24px;height:22px;display:grid;place-items:center;font-size:12px;color:var(--muted);line-height:1}
.iconbtn:hover{color:var(--ink);background:#333947}

/* palette */
.palgroup{margin-bottom:12px}
.palgroup h4{margin:0 0 6px;font-family:var(--ui);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--pink2);border-bottom:1px solid var(--line);padding-bottom:4px}
.pal{display:flex;flex-direction:column;gap:4px}
.palbtn{display:flex;align-items:center;gap:8px;text-align:left;background:#1a1d24;border:1px solid var(--line2);border-radius:var(--r);padding:6px 8px;font-size:12.3px;line-height:1.25}
.palbtn:hover{background:#252a34;border-color:#5a6272}
.palbtn .w{font-family:var(--mono);font-size:10.5px;color:var(--signal);background:#2a2418;border:1px solid #4a3d1f;border-radius:2px;padding:1px 4px;flex:0 0 auto}
.palbtn:active{transform:translateY(1px)}

/* stage */
#stage{flex:1;min-width:0;display:flex;flex-direction:column;background:
   linear-gradient(0deg,rgba(255,255,255,.02) 1px,transparent 1px) 0 0/24px 24px,
   linear-gradient(90deg,rgba(255,255,255,.02) 1px,transparent 1px) 0 0/24px 24px,#101216;overflow:auto}
.stagebar{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:10px;padding:7px 14px;background:rgba(21,23,28,.93);border-bottom:1px solid var(--line);backdrop-filter:blur(4px);font-size:11.5px;color:var(--muted);flex-wrap:wrap}
.zoomv{font-family:var(--mono);min-width:42px;text-align:center;color:var(--ink)}
#holder{margin:22px auto 60px}
#scaler{transform-origin:top left}
.sheet{display:none;background:var(--paper);color:var(--pink);position:relative;box-shadow:0 18px 50px rgba(0,0,0,.55);font-family:var(--body)}
.sheet.active{display:block}

/* ============ DRAWING SHEET ============ */
.frame{position:absolute;inset:8mm;border:.4mm solid #23272e}
.corner{position:absolute;width:4mm;height:4mm;border:.4mm solid #23272e;border-right:0;border-bottom:0}
.drawarea{position:absolute;left:4mm;right:4mm;top:4mm;bottom:38mm;display:flex;align-items:flex-start;justify-content:center;overflow:hidden}
.panelwrap{position:relative}
#panel{transform-origin:top left;display:inline-block}
.cabinet{border:.5mm solid #23272e;padding:6mm;background:#fafbfc}
.rowblock{margin-bottom:7mm}
.rowblock:last-child{margin-bottom:0}
.rowhead{display:flex;align-items:baseline;gap:3mm;font-family:var(--ui);font-size:3mm;letter-spacing:.1em;text-transform:uppercase;color:#3f4650;margin-bottom:1.2mm}
.rowhead .no{font-family:var(--mono);font-weight:700;color:#111;background:#f2b134;padding:.3mm 1.2mm}
.ruler{height:2.6mm;position:relative;border-bottom:.25mm solid #9aa2ad;margin-bottom:.6mm}
.ruler i{position:absolute;bottom:0;width:.25mm;height:1.4mm;background:#9aa2ad}
.ruler i.f{height:2.6mm;background:#5b6470}
.rail{display:flex;align-items:stretch;position:relative;background:#fff;border:.25mm solid #b9c0c9}
.rail::before{content:"";position:absolute;left:0;right:0;top:19mm;height:7mm;background:repeating-linear-gradient(90deg,#e7eaee 0 2mm,#dfe3e8 2mm 4mm);border-top:.25mm solid #b9c0c9;border-bottom:.25mm solid #b9c0c9;z-index:0}
.slot{flex:0 0 auto;height:45mm;border-right:.2mm dashed #cfd5dc;position:relative;z-index:1}
.slot:last-child{border-right:0}

/* devices */
.dev{position:relative;z-index:2;height:45mm;flex:0 0 auto;background:#fff;border:.35mm solid #23272e;display:flex;flex-direction:column;overflow:hidden;cursor:pointer}
.dev+.dev{border-left-width:.35mm}
.dev.sel{outline:.7mm solid #f2b134;outline-offset:-.35mm;z-index:4}
.dev .term{height:7mm;flex:0 0 auto;background:repeating-linear-gradient(90deg,#f4f6f8 0 4.6mm,#d3d9e0 4.6mm 12.9mm,#f4f6f8 12.9mm 17.5mm);border-bottom:.25mm solid #7d8590}
.dev .term.b{border-bottom:0;border-top:.25mm solid #7d8590}
.dev .face{flex:1;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.1mm;padding:1mm .6mm}
.dev.multi .face{background-image:repeating-linear-gradient(90deg,transparent 0 calc(17.5mm - .25mm),#c9cfd7 calc(17.5mm - .25mm) 17.5mm)}
.lever{width:6mm;height:9mm;background:#2a2f37;border-radius:.5mm;position:relative;z-index:2}
.lever::after{content:"";position:absolute;left:1.1mm;right:1.1mm;top:1.3mm;height:2.6mm;background:var(--live);border-radius:.3mm}
.lever.wide{width:9mm}
.rate{font-family:var(--mono);font-weight:600;font-size:3.1mm;line-height:1;z-index:2;letter-spacing:-.02em}
.sub{font-family:var(--mono);font-size:2.2mm;line-height:1;color:#59606b;z-index:2}
.tbtn{width:5mm;height:3.4mm;border:.3mm solid #23272e;border-radius:.4mm;display:grid;place-items:center;font-family:var(--mono);font-size:2.2mm;background:#eceff3;z-index:2}
.vname{font-family:var(--ui);font-size:2.6mm;letter-spacing:.04em;text-transform:uppercase;text-align:center;line-height:1.05;z-index:2}
.vname.rot{writing-mode:vertical-rl;transform:rotate(180deg);white-space:nowrap}
.win{border:.3mm solid #23272e;background:#e8ecf1;height:9mm;width:calc(100% - 4mm);display:grid;place-items:center;font-family:var(--mono);font-size:2.6mm;z-index:2}
.lampdot{width:7mm;height:7mm;border-radius:50%;border:.4mm solid #23272e;background:radial-gradient(circle at 38% 34%,#ffe9a8,#f2b134)}
.dev.form-blank{background:repeating-linear-gradient(45deg,#f3f5f7 0 1.2mm,#e6eaee 1.2mm 2.4mm);border-style:solid;border-color:#9aa2ad}
.dev.form-bus .face{background:#eef2f6}
.busline{width:calc(100% - 3mm);height:6mm;border:.3mm solid #23272e;background:repeating-linear-gradient(90deg,#dfe4ea 0 1.6mm,#fff 1.6mm 4.2mm);display:flex;align-items:center;justify-content:center;z-index:2}
.dev.bus-n .busline{background:repeating-linear-gradient(90deg,#cfe0f5 0 1.6mm,#fff 1.6mm 4.2mm)}
.dev.bus-pe .busline{background:repeating-linear-gradient(90deg,#d4ecd7 0 1.6mm,#fff 1.6mm 4.2mm)}
.screwrow{display:flex;gap:1.6mm;z-index:2}
.screwrow i{width:2.2mm;height:2.2mm;border-radius:50%;border:.25mm solid #6d757f;background:#fff}
/* fuses */
.dev.form-fuse .face{gap:.8mm}
.fusebody{width:24mm;height:24mm;border-radius:50%;border:.4mm solid #23272e;background:radial-gradient(circle at 38% 32%,#fff,#e4e8ed 70%);display:grid;place-items:center;z-index:2}
.fusedot{width:8.5mm;height:8.5mm;border-radius:50%;border:.3mm solid #3a3f47}
.dev.form-fuse .rate{font-size:3.4mm}
.swflag{position:absolute;top:1mm;right:1mm;font-family:var(--mono);font-size:2.2mm;border:.25mm solid #23272e;padding:0 .7mm;z-index:3}

/* strip (used in drawing + labels) */
.strip{display:flex;border:.25mm solid #23272e;background:#fff;margin-top:1.2mm}
.strip.cut{border-style:dashed}
.strip .cell{flex:0 0 auto;border-right:.2mm solid #c3c9d1;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;padding:.3mm .5mm;text-align:center;line-height:1.05}
.strip .cell:last-child{border-right:0}
.strip .cell .g{font-family:var(--mono);font-weight:700;font-size:calc(var(--fs) * 1.05);letter-spacing:-.02em}
.strip .cell .d{font-family:var(--ui);font-size:var(--fs);letter-spacing:.01em;overflow-wrap:anywhere}
.strip.vert .cell{writing-mode:vertical-rl;transform:rotate(180deg);flex-direction:row;gap:.6mm}
.strip.vert .cell .d{white-space:nowrap}

/* title block */
.titleblock{position:absolute;right:0;bottom:0;width:118mm;border:.4mm solid #23272e;background:#fff;display:grid;grid-template-columns:26mm 1fr 22mm 1fr}
.titleblock .c{border-right:.25mm solid #b9c0c9;border-bottom:.25mm solid #b9c0c9;padding:.9mm 1.4mm;min-height:6mm;display:flex;align-items:center}
.titleblock .c.k{font-family:var(--ui);font-size:2.4mm;letter-spacing:.08em;text-transform:uppercase;color:#6b7380;background:#f6f7f9}
.titleblock .c.v{font-family:var(--body);font-size:3mm;font-weight:600}
.titleblock .c.span4{grid-column:1/-1}
.titleblock .c.last{border-right:0}
.titleblock .c.bot{border-bottom:0}
.notesbox{position:absolute;left:0;bottom:0;width:calc(100% - 120mm);border:.4mm solid #23272e;background:#fff;padding:1.5mm 2mm;height:32mm;overflow:hidden}
.notesbox h6{margin:0 0 1mm;font-family:var(--ui);font-size:2.4mm;letter-spacing:.08em;text-transform:uppercase;color:#6b7380}
.notesbox p{margin:0;font-size:2.7mm;line-height:1.4;white-space:pre-wrap}
.legend{display:flex;gap:3mm;flex-wrap:wrap;margin-top:1.5mm;font-family:var(--mono);font-size:2.3mm;color:#4a515b}

/* ============ LABEL + LIST SHEETS ============ */
.sheet.flow{padding:10mm;height:auto}
.sheetTitle{font-family:var(--ui);text-transform:uppercase;letter-spacing:.12em;font-size:4mm;border-bottom:.4mm solid #23272e;padding-bottom:1.5mm;margin:0 0 2mm;display:flex;justify-content:space-between;align-items:baseline}
.sheetTitle span{font-family:var(--mono);font-size:2.8mm;letter-spacing:0;color:#5a616c;text-transform:none}
.printnote{font-size:2.7mm;color:#5a616c;margin:0 0 6mm;font-family:var(--body)}
.stripblock{margin-bottom:7mm;page-break-inside:avoid;break-inside:avoid}
.stripcap{font-family:var(--ui);font-size:2.8mm;letter-spacing:.08em;text-transform:uppercase;color:#5a616c;margin-bottom:1mm;display:flex;gap:3mm}
.stripcap b{color:#111}
.marks{position:relative}
.marks i{position:absolute;background:#8a929c;width:.25mm;height:2.5mm}
table.glist{width:100%;border-collapse:collapse;font-size:2.9mm}
table.glist th{background:#f1f3f6;font-family:var(--ui);text-transform:uppercase;letter-spacing:.06em;font-size:2.6mm;text-align:left}
table.glist th,table.glist td{border:.25mm solid #99a1ab;padding:1.1mm 1.6mm;vertical-align:top}
table.glist td.n{font-family:var(--mono);white-space:nowrap}
table.glist tr.rowsep td{background:#e9edf2;font-family:var(--ui);text-transform:uppercase;letter-spacing:.08em;font-size:2.6mm}

/* inspector */
.empty{padding:16px 12px;color:var(--muted);font-size:12px;line-height:1.6}
.chip{display:inline-flex;align-items:center;gap:6px;background:#2a2418;border:1px solid #4a3d1f;color:var(--signal);font-family:var(--mono);font-size:11px;padding:2px 6px;border-radius:2px}
.inspHead{padding:11px 12px;border-bottom:1px solid var(--line);background:#1a1d24}
.inspHead h3{margin:0 0 4px;font-family:var(--ui);font-size:15px;letter-spacing:.03em;font-weight:600}
.wbtns{display:flex;gap:4px}
.wbtns button{flex:1;background:#1a1d24;border:1px solid var(--line2);border-radius:var(--r);padding:5px 0;font-family:var(--mono);font-size:11px;color:var(--muted)}
.wbtns button.on{background:var(--signal);border-color:var(--signal);color:#161616;font-weight:600}
.kbd{font-family:var(--mono);background:#262b34;border:1px solid var(--line2);border-bottom-width:2px;border-radius:3px;padding:0 4px;font-size:10.5px}

.dropmark{position:absolute;top:0;bottom:0;width:1mm;background:var(--signal);z-index:9;pointer-events:none}
.dev.dragging{opacity:.35}

@media (max-width:1100px){
  aside{width:230px;flex-basis:230px}
  #right{width:238px;flex-basis:238px}
}
@media (max-width:820px){
  #main{flex-direction:column}
  aside,#right{width:auto;flex-basis:auto;max-height:38vh;border:0;border-top:1px solid var(--line)}
  #stage{order:-1;min-height:45vh}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}

/* ============ PRINT ============ */
@media print{
  html,body{overflow:visible;background:#fff;height:auto}
  #topbar,#left,#right,.stagebar,.no-print{display:none!important}
  #app,#main{display:block;height:auto}
  #stage{overflow:visible;background:#fff;display:block}
  #holder{margin:0!important;width:auto!important;height:auto!important}
  #scaler{transform:none!important}
  .sheet{box-shadow:none!important;margin:0}
  .sheet.flow{padding:0!important;width:auto!important;min-height:0!important}
  .dev.sel{outline:none!important}
  .rowblock{page-break-inside:avoid}
}
</style>
</head>
<body>
<div id="app">

<header id="topbar">
  <div class="brand"><b>⌁</b> Keskussuunnittelija</div>
  <nav class="tabs" id="tabs">
    <button data-view="drawing" class="active">Piirustus</button>
    <button data-view="labels">Merkintäliuskat</button>
    <button data-view="list">Ryhmäluettelo</button>
  </nav>
  <div class="spacer"></div>
  <div class="tool"><label class="tl" for="paper">Arkki</label>
    <select id="paper"><option>A4</option><option>A3</option></select>
    <select id="orient"><option value="landscape">Vaaka</option><option value="portrait">Pysty</option></select>
  </div>
  <div class="tool"><label class="tl" for="scalemode">Mittakaava</label>
    <select id="scalemode">
      <option value="fit">Sovita arkille</option>
      <option value="1">1:1 (todellinen koko)</option>
      <option value="0.75">75 %</option>
      <option value="0.5">50 %</option>
    </select>
  </div>
  <div class="tool">
    <button class="btn" id="btnSave">Tallenna työ</button>
    <button class="btn" id="btnOpen">Avaa työ</button>
    <button class="btn primary" id="btnPrint">Tulosta / PDF</button>
  </div>
  <input type="file" id="fileIn" accept=".json,application/json" hidden>
</header>

<div id="main">
  <!-- ======== LEFT ======== -->
  <aside id="left">
    <details class="sec" open>
      <summary>Rivit ja kojeet</summary>
      <div class="secbody">
        <div id="rowlist"></div>
        <div style="display:flex;gap:6px;margin-top:4px">
          <button class="btn sm" id="addDin" style="flex:1">+ DIN-rivi</button>
          <button class="btn sm" id="addTulppa" style="flex:1">+ Tulppasulakerivi</button>
        </div>
        <p class="hint" style="margin:10px 0 0">Valitse rivi, niin alla olevat kojeet lisätään siihen. Kojeen voi myös raahata paikalleen piirustuksessa.</p>
      </div>
    </details>

    <details class="sec" open>
      <summary>Kojeluettelo</summary>
      <div class="secbody" id="palette"></div>
    </details>

    <details class="sec">
      <summary>Keskuksen tiedot</summary>
      <div class="secbody" id="metaForm">
        <div class="field"><label>Kohde</label><input type="text" data-meta="kohde"></div>
        <div class="field"><label>Osoite</label><input type="text" data-meta="osoite"></div>
        <div class="grid2">
          <div class="field"><label>Keskustunnus</label><input type="text" data-meta="tunnus"></div>
          <div class="field"><label>Piirustusnro</label><input type="text" data-meta="pno"></div>
        </div>
        <div class="grid2">
          <div class="field"><label>Suunnittelija</label><input type="text" data-meta="tekija"></div>
          <div class="field"><label>Päiväys</label><input type="text" data-meta="pvm"></div>
        </div>
        <div class="grid2">
          <div class="field"><label>Nimellisvirta</label><input type="text" data-meta="ivirta" placeholder="3x25 A"></div>
          <div class="field"><label>Kotelointi</label><input type="text" data-meta="ip" placeholder="IP34"></div>
        </div>
        <div class="field"><label>Huomautukset</label><textarea rows="3" data-meta="huom"></textarea></div>
      </div>
    </details>

    <details class="sec">
      <summary>Liuskojen asetukset</summary>
      <div class="secbody" id="optForm">
        <div class="grid2">
          <div class="field"><label>Liuskan korkeus</label><input type="number" step="0.5" min="3" max="30" data-opt="stripH"></div>
          <div class="field"><label>Tekstikoko (mm)</label><input type="number" step="0.1" min="1.2" max="6" data-opt="fs"></div>
        </div>
        <div class="grid2">
          <div class="field"><label>Moduulin leveys</label><input type="number" step="0.1" min="8" max="30" data-opt="mod"></div>
          <div class="field"><label>Kopioita</label><input type="number" min="1" max="4" data-opt="copies"></div>
        </div>
        <div class="field"><label><input type="checkbox" data-opt="vert" style="width:auto;margin-right:6px">Pystysuora teksti</label></div>
        <div class="field"><label><input type="checkbox" data-opt="showGroup" style="width:auto;margin-right:6px">Näytä ryhmänumero</label></div>
        <div class="field"><label><input type="checkbox" data-opt="cut" style="width:auto;margin-right:6px">Leikkausviivat katkoviivana</label></div>
        <div class="field"><label><input type="checkbox" data-opt="showEmpty" style="width:auto;margin-right:6px">Näytä vapaat moduulit</label></div>
        <p class="hint">Vakioliuska: <code>17,5 mm/moduuli</code>. Tulosta liuskat aina <b>100 %</b> ilman sivun sovitusta, jotta mitat täsmäävät.</p>
      </div>
    </details>

    <details class="sec">
      <summary>Pohjat ja ohje</summary>
      <div class="secbody">
        <div style="display:flex;flex-direction:column;gap:6px">
          <button class="btn sm" data-tpl="asunto">Asunnon ryhmäkeskus (DIN)</button>
          <button class="btn sm" data-tpl="tulppa">Vanha tulppasulakekeskus</button>
          <button class="btn sm" data-tpl="tyhja">Tyhjä pohja</button>
        </div>
        <p class="hint" style="margin-top:12px">
          <b>Näppäimet</b><br>
          <span class="kbd">Del</span> poistaa valitun kojeen<br>
          <span class="kbd">←</span> <span class="kbd">→</span> siirtää kojetta rivillä<br>
          <span class="kbd">Esc</span> poistaa valinnan
        </p>
        <p class="hint" style="margin-top:10px">Työ tallentuu <code>.json</code>-tiedostoksi omalle koneelle. Avaa se myöhemmin “Avaa työ” -painikkeella.</p>
      </div>
    </details>
  </aside>

  <!-- ======== STAGE ======== -->
  <section id="stage">
    <div class="stagebar no-print">
      <button class="btn sm" id="zOut">−</button><span class="zoomv" id="zVal">100 %</span><button class="btn sm" id="zIn">+</button>
      <button class="btn sm" id="zFit">Sovita näkymään</button>
      <span id="stageHint">Napsauta kojetta muokataksesi. Raahaa järjestääksesi uudelleen.</span>
      <span class="spacer"></span>
      <button class="btn sm" id="autoNum">Numeroi ryhmät</button>
    </div>
    <div id="holder"><div id="scaler">
      <div class="sheet active" id="sheetDrawing" data-view="drawing"></div>
      <div class="sheet flow" id="sheetLabels" data-view="labels"></div>
      <div class="sheet flow" id="sheetList" data-view="list"></div>
    </div></div>
  </section>

  <!-- ======== RIGHT ======== -->
  <aside id="right"><div id="inspector"></div></aside>
</div>
</div>

<datalist id="dlDesc">
  <option>Valaistus</option><option>Pistorasiat</option><option>Keittiön pistorasiat</option>
  <option>Liesi</option><option>Sauna</option><option>Lämminvesivaraaja</option><option>Astianpesukone</option>
  <option>Pesukone</option><option>Jääkaappi/pakastin</option><option>Ilmanvaihto</option><option>Lattialämmitys</option>
  <option>Autolämmitys</option><option>Ulkovalaistus</option><option>ATK / antenni</option><option>Varaus</option>
</datalist>
<datalist id="dlCable">
  <option>MMJ 3x1,5S</option><option>MMJ 3x2,5S</option><option>MMJ 5x1,5S</option><option>MMJ 5x2,5S</option>
  <option>MMJ 5x6S</option><option>MCMK 4x10+10</option><option>MMO 4x16</option>
</datalist>
<datalist id="dlRating">
  <option>6A</option><option>10A</option><option>13A</option><option>16A</option><option>20A</option>
  <option>25A</option><option>32A</option><option>35A</option><option>40A</option><option>50A</option>
  <option>63A</option><option>80A</option>
</datalist>

<script>
"use strict";
/* ============================================================
   PERUSTA
============================================================ */
const $ = s => document.querySelector(s);
const $$ = s => Array.from(document.querySelectorAll(s));
const uid = () => Math.random().toString(36).slice(2, 9);
const PXMM = 96 / 25.4;
const PAPER = { A4: { w: 210, h: 297 }, A3: { w: 297, h: 420 } };
const esc = s => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

const FUSECOL = { "2A": "#f2a0c4", "4A": "#8b5a2b", "6A": "#2fa84f", "10A": "#d92c2c",
  "16A": "#9aa0a6", "20A": "#2b6ce0", "25A": "#f2c200", "35A": "#1a1a1a", "50A": "#f7f7f7", "63A": "#b87333" };

/* ============================================================
   KOJELUETTELO
============================================================ */
const CATALOG = [
  // Suojalaitteet
  { key:"js1",  name:"Johdonsuojakatkaisija 1-nap.", short:"JS", w:1, form:"breaker", prot:1, cat:"Suojalaitteet", def:{curve:"C",rating:"16A"}, fields:["curve","rating","cable"] },
  { key:"js1n", name:"Johdonsuoja 1-nap. + N",       short:"JS+N", w:2, form:"breaker", prot:1, cat:"Suojalaitteet", def:{curve:"C",rating:"16A"}, fields:["curve","rating","cable"] },
  { key:"js2",  name:"Johdonsuojakatkaisija 2-nap.", short:"JS", w:2, form:"breaker", prot:1, cat:"Suojalaitteet", def:{curve:"C",rating:"16A"}, fields:["curve","rating","cable"] },
  { key:"js3",  name:"Johdonsuojakatkaisija 3-nap.", short:"JS", w:3, form:"breaker", prot:1, cat:"Suojalaitteet", def:{curve:"C",rating:"16A"}, fields:["curve","rating","cable"] },
  { key:"rcbo", name:"Vikavirtajohdonsuoja (kombi)", short:"RCBO", w:2, form:"rcbo", prot:1, cat:"Suojalaitteet", def:{curve:"C",rating:"16A",ma:"30mA"}, fields:["curve","rating","ma","cable"] },
  { key:"rcd2", name:"Vikavirtasuojakytkin 2-nap.",  short:"VVSK", w:2, form:"rcd", cat:"Suojalaitteet", def:{rating:"40A",ma:"30mA"}, fields:["rating","ma"] },
  { key:"rcd4", name:"Vikavirtasuojakytkin 4-nap.",  short:"VVSK", w:4, form:"rcd", cat:"Suojalaitteet", def:{rating:"40A",ma:"30mA"}, fields:["rating","ma"] },
  { key:"spd",  name:"Ylijännitesuoja T2 (3+1)",     short:"SPD", w:4, form:"surge", cat:"Suojalaitteet", def:{rating:"T2"}, fields:["rating"] },
  // Kytkimet
  { key:"main3", name:"Pääkytkin 3-nap.",            short:"PK", w:3, form:"switch", cat:"Kytkimet", def:{rating:"63A"}, fields:["rating"] },
  { key:"main4", name:"Kuormanerotin 4-nap.",        short:"PK", w:4, form:"switch", cat:"Kytkimet", def:{rating:"63A"}, fields:["rating"] },
  { key:"fsw",   name:"Kytkinvaroke 3-nap.",         short:"KV", w:3, form:"switch", cat:"Kytkimet", def:{rating:"35A"}, fields:["rating"] },
  { key:"ohj",   name:"Ohjauskytkin",                short:"OK", w:1, form:"switch", cat:"Kytkimet", def:{}, fields:[] },
  { key:"kontaktori", name:"Kontaktori",             short:"K", w:2, form:"device", cat:"Kytkimet", def:{rating:"25A"}, fields:["rating"] },
  // Ohjaus
  { key:"pva",   name:"Porrasvaloautomaatti",        short:"PVA", w:1, form:"device", cat:"Ohjaus ja mittaus", def:{}, fields:[] },
  { key:"kello", name:"Kellokytkin / aikaohjaus",    short:"KELLO", w:2, form:"meter", cat:"Ohjaus ja mittaus", def:{}, fields:[] },
  { key:"rele",  name:"Asennusrele",                 short:"REL", w:1, form:"device", cat:"Ohjaus ja mittaus", def:{}, fields:[] },
  { key:"hamara",name:"Hämäräkytkin",                short:"HÄM", w:1, form:"device", cat:"Ohjaus ja mittaus", def:{}, fields:[] },
  { key:"dim",   name:"Himmennin",                   short:"DIM", w:1, form:"device", cat:"Ohjaus ja mittaus", def:{}, fields:[] },
  { key:"trafo", name:"Ovikellomuuntaja 8 V",        short:"TR", w:2, form:"device", cat:"Ohjaus ja mittaus", def:{}, fields:[] },
  { key:"mittari", name:"Energiamittari",            short:"kWh", w:4, form:"meter", cat:"Ohjaus ja mittaus", def:{}, fields:[] },
  { key:"lamppu", name:"Merkkilamppu",               short:"", w:1, form:"lamp", cat:"Ohjaus ja mittaus", def:{}, fields:[] },
  // Kiskot ja tarvikkeet
  { key:"nkisko", name:"Nollakisko (N)",             short:"N", w:2, form:"bus", cat:"Kiskot ja tarvikkeet", def:{}, fields:[] },
  { key:"pekisko",name:"PE-kisko",                   short:"PE", w:2, form:"bus", cat:"Kiskot ja tarvikkeet", def:{}, fields:[] },
  { key:"riviliitin", name:"Riviliittimet",          short:"RL", w:1, form:"terminal", cat:"Kiskot ja tarvikkeet", def:{}, fields:[] },
  { key:"peite",  name:"Peitelevy / vapaa",          short:"", w:1, form:"blank", cat:"Kiskot ja tarvikkeet", def:{}, fields:[] },
  { key:"muu",    name:"Muu koje (nimeä itse)",      short:"?", w:1, form:"device", cat:"Kiskot ja tarvikkeet", def:{}, fields:["rating"] },
  // Tulppasulakekeskus
  { key:"tulppa",  name:"Tulppasulake", short:"TS", w:2, form:"fuse", prot:1, kinds:["tulppa"], cat:"Tulppasulakkeet", def:{rating:"16A"}, fields:["rating","cable"] },
  { key:"tulppak", name:"Kytkintulppasulake", short:"KTS", w:2, form:"fuse", sw:1, prot:1, kinds:["tulppa"], cat:"Tulppasulakkeet", def:{rating:"16A"}, fields:["rating","cable"] },
  { key:"tpaa",    name:"Pääkytkin", short:"PK", w:2, form:"switch", kinds:["tulppa"], cat:"Tulppasulakkeet", def:{rating:"25A"}, fields:["rating"] },
  { key:"trima",   name:"Nollarima", short:"N", w:2, form:"bus", kinds:["tulppa"], cat:"Tulppasulakkeet", def:{}, fields:[] },
  { key:"ttyhja",  name:"Tyhjä paikka", short:"", w:2, form:"blank", kinds:["tulppa"], cat:"Tulppasulakkeet", def:{}, fields:[] }
];
CATALOG.forEach(c => { if (!c.kinds) c.kinds = ["din"]; });
const CAT = Object.fromEntries(CATALOG.map(c => [c.key, c]));

/* ============================================================
   TILA
============================================================ */
function newDev(key, over) {
  const c = CAT[key];
  return Object.assign({ id: uid(), key, w: c.w, group: "", desc: "", cable: "" }, c.def, over || {});
}
function newRow(kind, name, modules) {
  return { id: uid(), kind, name: name || (kind === "din" ? "Kiskorivi" : "Sulakerivi"), modules: modules || (kind === "din" ? 12 : 12), devices: [] };
}
function template(which) {
  const base = {
    meta: { kohde: "", osoite: "", tunnus: "JK1", pno: "", tekija: "", pvm: new Date().toLocaleDateString("fi-FI"), ivirta: "3x25 A", ip: "IP34", huom: "" },
    paper: "A4", orient: "landscape", scaleMode: "fit",
    opts: { stripH: 8, fs: 2.3, mod: 17.5, copies: 1, vert: false, showGroup: true, cut: true, showEmpty: true },
    rows: []
  };
  if (which === "tyhja") { base.rows = [newRow("din", "Kiskorivi 1", 12)]; return base; }
  if (which === "tulppa") {
    base.meta.tunnus = "RK";
    const r1 = newRow("tulppa", "Sulakerivi 1", 12);
    r1.devices = [ newDev("tpaa", { desc: "Pääkytkin" }),
      newDev("tulppa", { rating: "25A", group: "1", desc: "Liesi L1", cable: "MMJ 5x2,5S" }),
      newDev("tulppa", { rating: "25A", group: "1", desc: "Liesi L2" }),
      newDev("tulppa", { rating: "25A", group: "1", desc: "Liesi L3" }),
      newDev("trima", { desc: "Nollarima" }), newDev("ttyhja") ];
    const r2 = newRow("tulppa", "Sulakerivi 2", 12);
    r2.devices = [ newDev("tulppa", { rating: "10A", group: "2", desc: "Valaistus OH", cable: "MMJ 3x1,5S" }),
      newDev("tulppa", { rating: "10A", group: "3", desc: "Valaistus MH" }),
      newDev("tulppa", { rating: "16A", group: "4", desc: "Pistorasiat OH", cable: "MMJ 3x2,5S" }),
      newDev("tulppa", { rating: "16A", group: "5", desc: "Pistorasiat keittiö" }),
      newDev("tulppa", { rating: "16A", group: "6", desc: "Kylmälaitteet" }),
      newDev("ttyhja") ];
    base.rows = [r1, r2];
    return base;
  }
  // asunto
  base.meta.kohde = "Asunto";
  const a = newRow("din", "Kiskorivi 1", 12);
  a.devices = [ newDev("main4", { rating: "63A", desc: "Pääkytkin" }), newDev("spd", { desc: "Ylijännitesuoja" }),
    newDev("mittari", { desc: "Energiamittari" }) ];
  const b = newRow("din", "Kiskorivi 2", 12);
  b.devices = [ newDev("rcd4", { rating: "40A", ma: "30mA", desc: "Vikavirtasuoja" }),
    newDev("js1", { rating: "10A", curve: "B", group: "1", desc: "Valaistus OH", cable: "MMJ 3x1,5S" }),
    newDev("js1", { rating: "10A", curve: "B", group: "2", desc: "Valaistus MH", cable: "MMJ 3x1,5S" }),
    newDev("js1", { rating: "16A", curve: "C", group: "3", desc: "Pistorasiat OH", cable: "MMJ 3x2,5S" }),
    newDev("js1", { rating: "16A", curve: "C", group: "4", desc: "Pistorasiat MH", cable: "MMJ 3x2,5S" }),
    newDev("js1", { rating: "16A", curve: "C", group: "5", desc: "Keittiö", cable: "MMJ 3x2,5S" }),
    newDev("js1", { rating: "16A", curve: "C", group: "6", desc: "Kylmälaitteet", cable: "MMJ 3x2,5S" }),
    newDev("peite") ];
  const c = newRow("din", "Kiskorivi 3", 12);
  c.devices = [ newDev("js3", { rating: "16A", curve: "C", group: "7", desc: "Liesi", cable: "MMJ 5x2,5S" }),
    newDev("js3", { rating: "16A", curve: "C", group: "8", desc: "Sauna", cable: "MMJ 5x2,5S" }),
    newDev("rcbo", { rating: "16A", ma: "30mA", group: "9", desc: "Ulkopistorasiat", cable: "MMJ 3x2,5S" }),
    newDev("nkisko", { desc: "Nollakisko" }), newDev("pekisko", { desc: "PE-kisko" }) ];
  base.rows = [a, b, c];
  return base;
}

let state = template("asunto");
let view = "drawing";
let sel = { row: state.rows[1].id, dev: null };
let zoom = 1, zoomAuto = true;

const MOD = () => state.opts.mod || 17.5;
const rowById = id => state.rows.find(r => r.id === id);
const findDev = id => { for (const r of state.rows) { const d = r.devices.find(x => x.id === id); if (d) return { row: r, dev: d }; } return null; };
const used = r => r.devices.reduce((s, d) => s + d.w, 0);

/* ============================================================
   RENDERÖINTI — SIVUPALKIT
============================================================ */
function renderRowList() {
  $("#rowlist").innerHTML = state.rows.map((r, i) => {
    const u = used(r), over = u > r.modules;
    return `<div class="rowitem ${r.id === sel.row ? "active" : ""}" data-row="${r.id}">
      <div class="rhead"><span class="rno">${i + 1}</span>
        <input class="rname" data-rf="name" value="${esc(r.name)}">
      </div>
      <div class="rmeta">
        <select data-rf="kind"><option value="din"${r.kind === "din" ? " selected" : ""}>DIN-kisko</option><option value="tulppa"${r.kind === "tulppa" ? " selected" : ""}>Tulppasulake</option></select>
        <input type="number" min="1" max="60" data-rf="modules" value="${r.modules}"> mod
        <span class="usage ${over ? "over" : ""}">${u}/${r.modules}</span>
      </div>
      <div class="rowbtns">
        <button class="iconbtn" data-ract="up" title="Siirrä ylös">↑</button>
        <button class="iconbtn" data-ract="down" title="Siirrä alas">↓</button>
        <button class="iconbtn" data-ract="dup" title="Monista rivi">⧉</button>
        <button class="iconbtn" data-ract="clear" title="Tyhjennä rivi">⌫</button>
        <button class="iconbtn" data-ract="del" title="Poista rivi" style="margin-left:auto">✕</button>
      </div>
    </div>`;
  }).join("");
}

function renderPalette() {
  const r = rowById(sel.row) || state.rows[0];
  const kind = r ? r.kind : "din";
  const items = CATALOG.filter(c => c.kinds.includes(kind));
  const cats = [...new Set(items.map(c => c.cat))];
  $("#palette").innerHTML = cats.map(cat => `<div class="palgroup"><h4>${cat}</h4><div class="pal">` +
    items.filter(c => c.cat === cat).map(c =>
      `<button class="palbtn" data-add="${c.key}" draggable="true"><span class="w">${c.w}M</span><span>${esc(c.name)}</span></button>`
    ).join("") + `</div></div>`).join("");
}

function renderInspector() {
  const box = $("#inspector");
  const found = sel.dev ? findDev(sel.dev) : null;
  if (!found) {
    const r = rowById(sel.row);
    box.innerHTML = `<div class="empty">
      <p style="margin-top:0">Ei valittua kojetta.</p>
      <p>${r ? "Aktiivinen rivi: <b>" + esc(r.name) + "</b>. Lisää kojeita vasemmalta tai napsauta piirustuksesta kojetta muokataksesi sitä." : "Lisää ensin rivi."}</p>
    </div>`;
    return;
  }
  const { row, dev } = found, c = CAT[dev.key];
  const f = c.fields;
  const altKeys = CATALOG.filter(x => x.kinds.includes(row.kind));
  box.innerHTML = `
    <div class="inspHead">
      <h3>${esc(c.name)}</h3>
      <span class="chip">${esc(row.name)} · ${dev.w}M</span>
    </div>
    <div class="secbody" style="padding-top:12px">
      <div class="field"><label>Kojetyyppi</label>
        <select id="iKey">${altKeys.map(x => `<option value="${x.key}"${x.key === dev.key ? " selected" : ""}>${esc(x.name)}</option>`).join("")}</select>
      </div>
      <div class="field"><label>Leveys (moduulia)</label>
        <div class="wbtns">${[1,2,3,4,6,8].map(n => `<button data-w="${n}" class="${dev.w === n ? "on" : ""}">${n}M</button>`).join("")}</div>
      </div>
      ${f.includes("curve") ? `<div class="field"><label>Laukaisukäyrä</label>
        <select id="iCurve">${["B","C","D","-"].map(x => `<option${x === (dev.curve || "-") ? " selected" : ""}>${x}</option>`).join("")}</select></div>` : ""}
      ${f.includes("rating") ? `<div class="field"><label>Nimellisvirta / merkintä</label>
        <input type="text" id="iRating" list="dlRating" value="${esc(dev.rating || "")}"></div>` : ""}
      ${f.includes("ma") ? `<div class="field"><label>Vikavirta</label>
        <select id="iMa">${["10mA","30mA","100mA","300mA","-"].map(x => `<option${x === (dev.ma || "-") ? " selected" : ""}>${x}</option>`).join("")}</select></div>` : ""}
      <div class="field"><label>Ryhmänumero</label><input type="text" id="iGroup" value="${esc(dev.group || "")}"></div>
      <div class="field"><label>Merkintäteksti</label><input type="text" id="iDesc" list="dlDesc" value="${esc(dev.desc || "")}"></div>
      ${f.includes("cable") ? `<div class="field"><label>Kaapeli</label>
        <input type="text" id="iCable" list="dlCable" value="${esc(dev.cable || "")}"></div>` : ""}
      <div style="display:flex;gap:6px;margin-top:12px">
        <button class="btn sm" id="iLeft" style="flex:1">← Siirrä</button>
        <button class="btn sm" id="iRight" style="flex:1">Siirrä →</button>
      </div>
      <div style="display:flex;gap:6px;margin-top:6px">
        <button class="btn sm" id="iDup" style="flex:1">Monista</button>
        <button class="btn sm danger" id="iDel" style="flex:1">Poista</button>
      </div>
    </div>`;
}

/* ============================================================
   RENDERÖINTI — KOJEET
============================================================ */
function devInner(d) {
  const c = CAT[d.key], m = MOD();
  const rate = esc([d.curve && d.curve !== "-" ? d.curve : "", d.rating || ""].join(""));
  const poles = Math.max(1, Math.round(d.w));
  switch (c.form) {
    case "breaker":
      return `<div class="term"></div><div class="face"><div class="lever${d.w > 1 ? " wide" : ""}"></div>
        <div class="rate">${rate || "&nbsp;"}</div></div><div class="term b"></div>`;
    case "rcbo":
      return `<div class="term"></div><div class="face"><div class="tbtn">T</div><div class="lever"></div>
        <div class="rate">${rate}</div><div class="sub">${esc(d.ma || "")}</div></div><div class="term b"></div>`;
    case "rcd":
      return `<div class="term"></div><div class="face"><div class="tbtn">T</div><div class="lever wide"></div>
        <div class="rate">${esc(d.rating || "")}</div><div class="sub">${esc(d.ma || "")}</div></div><div class="term b"></div>`;
    case "switch":
      return `<div class="term"></div><div class="face"><div class="sub">0 / I</div><div class="lever wide" style="height:11mm"></div>
        <div class="rate">${esc(d.rating || "")}</div></div><div class="term b"></div>`;
    case "surge":
      return `<div class="term"></div><div class="face"><div style="display:flex;gap:1.4mm">${Array.from({length:poles},()=>'<i style="display:block;width:3.4mm;height:6mm;border:.3mm solid #23272e;background:#5ec27a"></i>').join("")}</div>
        <div class="rate">${esc(d.rating || "T2")}</div></div><div class="term b"></div>`;
    case "meter":
      return `<div class="term"></div><div class="face"><div class="win">${esc(c.short)}</div>
        <div class="sub">${esc(d.rating || "")}</div></div><div class="term b"></div>`;
    case "lamp":
      return `<div class="term"></div><div class="face"><div class="lampdot"></div></div><div class="term b"></div>`;
    case "terminal":
      return `<div class="term"></div><div class="face"><div class="screwrow">${Array.from({length:poles*2},()=>"<i></i>").join("")}</div>
        <div class="vname${d.w === 1 ? " rot" : ""}">${esc(d.desc || c.short)}</div></div><div class="term b"></div>`;
    case "bus": {
      const cls = d.key === "pekisko" ? "" : "";
      return `<div class="face" style="flex:1"><div class="busline"><span class="rate" style="font-size:2.8mm">${esc(c.short)}</span></div>
        <div class="screwrow">${Array.from({length:Math.max(3,poles*2)},()=>"<i></i>").join("")}</div>
        <div class="sub">${esc(d.desc || "")}</div></div>`;
    }
    case "blank":
      return `<div class="face"></div>`;
    case "fuse": {
      const col = FUSECOL[(d.rating || "").toUpperCase()] || "#c8ccd2";
      return `<div class="term"></div><div class="face">
        ${c.sw ? '<div class="swflag">0/I</div>' : ""}
        <div class="fusebody"><div class="fusedot" style="background:${col}"></div></div>
        <div class="rate">${esc(d.rating || "")}</div></div><div class="term b"></div>`;
    }
    default:
      return `<div class="term"></div><div class="face"><div class="vname${d.w === 1 ? " rot" : ""}">${esc(c.short || d.desc || "")}</div>
        ${d.rating ? `<div class="sub">${esc(d.rating)}</div>` : ""}</div><div class="term b"></div>`;
  }
}
function devHTML(d) {
  const c = CAT[d.key], m = MOD();
  const cls = ["dev", "form-" + c.form, d.w > 1 ? "multi" : "", d.id === sel.dev ? "sel" : "",
    d.key === "nkisko" ? "bus-n" : "", d.key === "pekisko" ? "bus-pe" : ""].filter(Boolean).join(" ");
  return `<div class="${cls}" data-dev="${d.id}" draggable="true" style="width:${(d.w * m).toFixed(3)}mm">${devInner(d)}</div>`;
}

function stripHTML(row, forDrawing) {
  const o = state.opts, m = MOD();
  const cells = [];
  for (const d of row.devices) {
    const c = CAT[d.key];
    const showG = o.showGroup && d.group;
    const txt = d.desc || (c.form === "blank" ? "" : "");
    cells.push(`<div class="cell" style="width:${(d.w * m).toFixed(3)}mm">
      ${showG ? `<div class="g">${esc(d.group)}</div>` : ""}${txt ? `<div class="d">${esc(txt)}</div>` : ""}</div>`);
  }
  const free = Math.max(0, row.modules - used(row));
  for (let i = 0; i < free; i++) cells.push(`<div class="cell" style="width:${m.toFixed(3)}mm"></div>`);
  const w = Math.max(row.modules, used(row)) * m;
  return `<div class="strip${o.cut ? " cut" : ""}${o.vert ? " vert" : ""}" style="width:${w.toFixed(3)}mm;height:${o.stripH}mm;--fs:${o.fs}mm">${cells.join("")}</div>`;
}

function rowBlockHTML(row, i) {
  const m = MOD(), u = used(row);
  const total = Math.max(row.modules, u);
  const railW = total * m;
  let ticks = "";
  for (let k = 0; k <= total; k++) ticks += `<i class="${k % 6 === 0 ? "f" : ""}" style="left:${(k * m).toFixed(3)}mm"></i>`;
  const devs = row.devices.map(devHTML).join("");
  let slots = "";
  if (state.opts.showEmpty) {
    const free = Math.max(0, row.modules - u);
    for (let k = 0; k < free; k++) slots += `<div class="slot" style="width:${m.toFixed(3)}mm"></div>`;
  }
  return `<div class="rowblock" data-rowblock="${row.id}">
    <div class="rowhead"><span class="no">${i + 1}</span><span>${esc(row.name)}</span>
      <span>${row.kind === "din" ? "DIN-kisko" : "Tulppasulakkeet"} · ${total} × ${m.toFixed(1).replace(".", ",")} mm</span></div>
    <div class="ruler" style="width:${railW.toFixed(3)}mm">${ticks}</div>
    <div class="rail" data-rail="${row.id}" style="width:${railW.toFixed(3)}mm">${devs}${slots}</div>
    ${stripHTML(row, true)}
  </div>`;
}

/* ============================================================
   ARKIT
============================================================ */
function pageDims() {
  const p = PAPER[state.paper], land = state.orient === "landscape";
  return { w: land ? p.h : p.w, h: land ? p.w : p.h };
}
function titleBlockHTML(scaleTxt) {
