        window.login = function(email) {
            window.currentUser = email;
            localStorage.setItem('currentUser', email);
            localStorage.setItem('lastEmail', email);
            document.getElementById('userEmailDisplay').textContent = email;
            
            if (isCloudActive && db) {
                try {
                    unsubCloud = onSnapshot(doc(db, "rentola", "kirjasto"), { includeMetadataChanges: true }, (docSnap) => {
                        if (!window.currentUser) return;
                        
                        if (docSnap.exists()) {
                            window.appData = docSnap.data();
                            window.isSafeToWriteToCloud = true; 
                        } else {
                            if (!docSnap.metadata.fromCache) {
                                window.appData = { products: [], groups: [], allowedUsers: [] };
                                window.isSafeToWriteToCloud = true; 
                            } else {
                                window.isSafeToWriteToCloud = false;
                                const statusEl = document.getElementById('cloudStatus');
                                statusEl.innerHTML = "⚠️ Ei yhteyttä. Tietoja ei voida varmistaa pilvestä.";
                                statusEl.className = "status-warn";
                                fallbackToLocalDataOnly();
                            }
                        }
                        checkAuthAndFinalize();
                    }, (error) => {
                        window.isSafeToWriteToCloud = false;
                        fallbackToLocal();
                    });
                } catch(e) { 
                    window.isSafeToWriteToCloud = false;
                    fallbackToLocal(); 
                }
            } else {
                window.isSafeToWriteToCloud = false;
                fallbackToLocal();
            }
        }

        function fallbackToLocalDataOnly() {
            const savedData = localStorage.getItem('appData');
            if (savedData) {
                try { window.appData = JSON.parse(savedData); } catch(e) { window.appData = { products: [], groups: [], allowedUsers: [] }; }
            } else {
                window.appData = { products: [], groups: [], allowedUsers: [] };
            }
        }

        function fallbackToLocal() {
            fallbackToLocalDataOnly();
            checkAuthAndFinalize();
        }

        function checkAuthAndFinalize() {
            if (!window.appData.allowedUsers) window.appData.allowedUsers = [];
            const isAdmin = (window.currentUser === ADMIN_EMAIL);

            if (isAdmin) {
                if (!window.appData.adminPassword) {
                    if (!window.tempAdminPassword) {
                        alert("Kirjoita uusi salasana salasanakenttään.");
                        window.logout(true);
                        return;
                    }
                    window.appData.adminPassword = window.tempAdminPassword;
                    window.saveData();
                } else {
                    if (window.tempAdminPassword && window.tempAdminPassword !== window.appData.adminPassword) {
                        alert("Väärä salasana!");
                        window.tempAdminPassword = null;
                        window.logout(true);
                        return;
                    }
                }
                window.tempAdminPassword = null; 
            } else {
                if (!window.appData.allowedUsers.includes(window.currentUser)) {
                    alert(`Pääsy evätty!\n\nSähköpostiosoitettasi ei ole sallittu järjestelmässä.\nPyydä ylläpitäjää (${ADMIN_EMAIL}) lisäämään sinut.`);
                    window.logout(true);
                    return;
                }
            }

            if (!window.appData.groups) window.appData.groups = [];
            if (!window.appData.products) window.appData.products = [];
            if (window.appData.groups.filter(g => g.owner === window.currentUser).length === 0) {
                window.appData.groups.push({ id: Date.now().toString(), name: "Oletus", owner: window.currentUser, sharedWith: [], hiddenBy: [] });
            }

            document.getElementById('loginView').classList.add('hidden');
            document.getElementById('appHeader').classList.remove('hidden');
            
            if(isAdmin) document.getElementById('navUsers').style.display = 'inline-block';
            else document.getElementById('navUsers').style.display = 'none';

            if (document.getElementById('homeTab').classList.contains('hidden') && 
                document.getElementById('groupsTab').classList.contains('hidden') && 
                document.getElementById('usersTab').classList.contains('hidden')) {
                window.switchTab('home');
            } else {
                window.updateSelects();
                window.renderProducts();
                window.renderGroups();
                if(isAdmin) window.renderUsers();
            }
            window.updateSelects();
        }

