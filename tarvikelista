        // KORJATTU JA TEHOKAS KUVAN PAKKAUS 
        window.compressImage = function(file, maxDimension = 600) {
            return new Promise((resolve, reject) => {
                if (!file) return resolve(null);
                if (!file.type.match(/image.*/)) return reject(new Error("Valittu tiedosto ei ole kuva."));
                
                const reader = new FileReader();
                reader.onload = event => {
                    const img = new Image();
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        let width = img.width, height = img.height;
                        
                        if (width > maxDimension || height > maxDimension) {
                            if (width > height) {
                                height = Math.round((height * maxDimension) / width);
                                width = maxDimension;
                            } else {
                                width = Math.round((width * maxDimension) / height);
                                height = maxDimension;
                            }
                        }
                        canvas.width = width; canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);
                        
                        // Tallennus WebP-muodossa tiukalla pakkauksella varmistaa todella pienen koon
                        resolve(canvas.toDataURL('image/webp', 0.6));
                    };
                    img.onerror = () => reject(new Error("Kuvan prosessointi epäonnistui."));
                    img.src = event.target.result;
                };
                reader.onerror = () => reject(new Error("Tiedoston luku epäonnistui."));
                reader.readAsDataURL(file);
            });
        }

