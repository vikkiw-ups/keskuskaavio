        window.submitProductForm = async function() {
            const submitBtn = document.getElementById('saveProductBtn');
            submitBtn.disabled = true; 
            submitBtn.textContent = "Tallennetaan...";

            try {
                const fileInput = document.getElementById('pFile');
                const file = fileInput.files ? fileInput.files[0] : null;
                let imageData = null;
                
                if(file) {
                    imageData = await window.compressImage(file);
                }
                
                const pId = document.getElementById('pId').value;
                const pName = document.getElementById('pName').value;
                const pNum = document.getElementById('pNumber').value;
                const pKey = document.getElementById('pKeywords').value;
                const pGrp = document.getElementById('pGroup').value;

                if (pId) {
                    const pIndex = window.appData.products.findIndex(x => x.id === pId);
                    if (pIndex > -1) {
                        window.appData.products[pIndex].name = pName;
                        window.appData.products[pIndex].number = pNum;
                        window.appData.products[pIndex].keywords = pKey;
                        window.appData.products[pIndex].groupId = pGrp;
                        if (imageData) window.appData.products[pIndex].image = imageData;
                    }
                } else {
                    window.appData.products.unshift({
                        id: Date.now().toString(), 
                        name: pName,
                        number: pNum, 
                        keywords: pKey,
                        groupId: pGrp, 
                        image: imageData,
                        owner: window.currentUser, 
                        favorites: []
                    });
                }
                
                await window.saveData(); 
                window.closeModal('productModal'); 
                window.renderProducts();
            } catch (err) {
                alert("Virhe tallennettaessa: " + err.message);
            } finally {
                submitBtn.disabled = false; 
                submitBtn.textContent = "Tallenna tuote";
            }
        };

        window.renderProducts = function() {
            const grid = document.getElementById('productGrid');
            if(!grid) return;
            
            const searchTerm = (document.getElementById('searchInput').value || '').toLowerCase();
            const selectedGroup = document.getElementById('filterGroup').value || 'all';
            const favFilter = document.getElementById('filterFav').value || 'all';
            const visibleGroups = getVisibleGroups().map(g => g.id);

            grid.innerHTML = '';
            if(!window.appData || !window.appData.products) return;

            const filtered = window.appData.products.filter(p => {
                if (!visibleGroups.includes(p.groupId)) return false;
                const groupInfo = window.appData.groups.find(g => g.id === p.groupId);
                const isGroupHidden = groupInfo && groupInfo.hiddenBy && groupInfo.hiddenBy.includes(window.currentUser);
                if (selectedGroup === 'all' && isGroupHidden) return false;
                if (selectedGroup !== 'all' && p.groupId !== selectedGroup) return false;
                if (favFilter === 'fav' && !(p.favorites || []).includes(window.currentUser)) return false;
                
                const pName = p.name || '';
                const pNum = p.number || '';
                const pKey = p.keywords || '';
                const searchString = `${pName} ${pNum} ${pKey}`.toLowerCase();
                
                if (searchTerm && !searchString.includes(searchTerm)) return false;
                return true;
            });

            if(filtered.length === 0) { grid.innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 3rem; color: var(--text-muted);">Ei tuotteita näillä hakuehdoilla.</div>`; return; }

            filtered.forEach(p => {
                const groupName = window.appData.groups.find(g => g.id === p.groupId)?.name || 'Ei ryhmää';
                const isFav = (p.favorites || []).includes(window.currentUser);
                const imgSrc = p.image ? p.image : defaultImageStr;
                const imgClass = p.image ? 'product-image' : 'product-image default-img';
                const tagsHTML = p.keywords ? p.keywords.split(',').map(k => k.trim()).filter(k=>k).map(k => `<span class="tag">${k}</span>`).join('') : '';

                const card = document.createElement('div'); card.className = 'product-card';
                card.innerHTML = `
                    <div class="card-actions">
                        <button class="icon-btn ${isFav ? 'fav-active' : ''}" onclick="event.stopPropagation(); window.toggleFavorite('${p.id}')" title="Suosikki"> ${isFav ? '⭐' : '☆'} </button>
                        ${p.owner === window.currentUser || window.currentUser === ADMIN_EMAIL ? `
                            <button class="icon-btn" onclick="event.stopPropagation(); window.openProductModal('${p.id}')" title="Muokkaa">✏️</button>
                            <button class="icon-btn" onclick="event.stopPropagation(); window.deleteProduct('${p.id}')" title="Poista" style="color: var(--danger-color)">🗑️</button>
                        ` : ''}
                    </div>
                    <div class="img-wrapper" onclick="window.copyNum(event, '${p.number}')">
                        <img src="${imgSrc}" class="${imgClass}" loading="lazy" title="Kopioi numero: ${p.number}">
                    </div>
                    <div class="product-info" onclick="window.copyNum(event, '${p.number}')" title="Kopioi numero: ${p.number}">
                        <div class="product-name">${p.name}</div>
                        <div class="product-number">${p.number}</div>
                        <div class="keywords">
                            <span class="tag" style="background: var(--primary-light); color: var(--primary-hover); border-color: var(--primary-border); font-weight:600;">${groupName}</span>
                            ${tagsHTML}
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function getVisibleGroups() {
            if(window.currentUser === ADMIN_EMAIL) return window.appData.groups || [];
            return (window.appData.groups || []).filter(g => g.owner === window.currentUser || (g.sharedWith && g.sharedWith.includes(window.currentUser)));
