            window.saveData(); window.renderProducts();
        }

        window.copyNum = function(e, text) {
            if(e) { e.stopPropagation(); e.preventDefault(); }

            const showToast = (copiedText) => {
                const t = document.getElementById('toast'); 
                t.textContent = `Kopioitu: ${copiedText}`;
                t.classList.add('show'); 
                setTimeout(() => t.classList.remove('show'), 2000);
            };

            const fallbackCopy = (textToCopy) => {
                const textArea = document.createElement("textarea");
                textArea.value = textToCopy;
                textArea.style.top = "0"; textArea.style.left = "0"; textArea.style.position = "fixed"; textArea.style.opacity = "0";
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                try {
                    document.execCommand('copy');
                    showToast(textToCopy);
                } catch (err) {
                    alert(`Tuotenumero: ${textToCopy}`);
                }
                document.body.removeChild(textArea);
            };

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text).then(() => showToast(text)).catch(() => fallbackCopy(text));
            } else {
                fallbackCopy(text);
            }
        }

        // Takaa sen, että moduulin käynnistyessä sovellus on valmis
        window.init();
    </script>
</body>
</html>
